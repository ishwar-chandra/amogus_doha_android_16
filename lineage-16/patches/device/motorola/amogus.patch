diff --git a/sepolicy/file_contexts b/sepolicy/file_contexts
index 03c9a0c..074e972 100644
--- a/sepolicy/file_contexts
+++ b/sepolicy/file_contexts
@@ -18,3 +18,9 @@
 
 # Sensors
 /vendor/etc/sensors(/.*)? u:object_r:vendor_sensor_data_file:s0
+
+# Thermal HAL: legacy-um's file_contexts only labels the AIDL-variant
+# binary name (android.hardware.thermal-service.qti); doha ships the
+# older HIDL @2.0 QTI implementation instead, which falls through to
+# the generic vendor_file label with no init->HAL domain transition.
+/vendor/bin/hw/android\.hardware\.thermal@2\.0-service\.qti u:object_r:hal_thermal_default_exec:s0
