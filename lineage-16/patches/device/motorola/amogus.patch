diff --git a/Android.mk b/Android.mk
index 1a6f520..7ff828b 100644
--- a/Android.mk
+++ b/Android.mk
@@ -4,10 +4,12 @@ LOCAL_PATH := $(call my-dir)
 
 include $(call all-subdir-makefiles)
 
+ifneq ($(PRODUCT_VENDOR_KERNEL_HEADERS),)
 $(TARGET_OUT_INTERMEDIATES)/KERNEL_OBJ/usr: $(wildcard $(PRODUCT_VENDOR_KERNEL_HEADERS)/*)
 	rm -rf $@
 	mkdir -p $@/include
 	cp -a $(PRODUCT_VENDOR_KERNEL_HEADERS)/. $@/include
+endif
 
 include $(CLEAR_VARS)
 LOCAL_MODULE := amogus_folders
diff --git a/device.mk b/device.mk
index 9caa77f..6a57fdb 100644
--- a/device.mk
+++ b/device.mk
@@ -19,6 +19,12 @@ PLATFORM_COMMON_PATH := device/motorola/amogus
 AB_OTA_UPDATER := true
 PRODUCT_SHIPPING_API_LEVEL := 29
 
+# This device carries forward a real 4.14 (non-GKI) kernel past the point
+# where AOSP's bundled compatibility matrices still ship 4.14 kernel-config
+# requirements at FCM level 5 (the level PRODUCT_SHIPPING_API_LEVEL=29 maps
+# to) -- checkvintf's kernel/FCM pairing check would otherwise always fail.
+PRODUCT_OTA_ENFORCE_VINTF_KERNEL_REQUIREMENTS := false
+
 AB_OTA_PARTITIONS += \
     boot \
     dtbo \
